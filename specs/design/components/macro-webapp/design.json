  ],
  "description": "Single-page React app for both Client and Coach. A Client logs food entries, sets/updates their daily goal, reviews today's and past progress, and manages Coach access grants. A Coach signs in to see the list of Clients who granted them access and view each one's log/goal read-only. Holds no data of its own — all state comes from macro-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "macro-api",
      "wiring": {
        "endpoint": {
          "component": "simplest-food-macro62352-macro-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "MACRO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-food-mac-20ff8e65",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
